pipeline {
    agent any

    environment {
        // Habilita el modo headless en CI y Jenkins
        CI = 'true'
        HEADLESS = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Clonando el repositorio en la rama wdioprueba...'
                git branch: 'wdioprueba', url: 'https://github.com/Soysakiaytuno/jenkins-prueba-qa2.git'
            }
        }

        stage('Instalar Dependencias') {
            steps {
                echo 'Instalando dependencias de Node.js...'
                script {
                    if (isUnix()) {
                        sh 'npm install'
                    } else {
                        bat 'npm install'
                    }
                }
            }
        }

        stage('Ejecutar Pruebas WDIO') {
            steps {
                echo 'Ejecutando pruebas WebdriverIO (Cucumber)...'
                script {
                    if (isUnix()) {
                        sh 'npx wdio run wdio.conf.js'
                    } else {
                        bat 'npx wdio run wdio.conf.js'
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Generando reporte Allure...'
            script {
                // Se genera en 'always' para que el reporte esté disponible incluso si una prueba falla
                if (isUnix()) {
                    sh 'npx allure generate allure-results --clean -o allure-report'
                } else {
                    bat 'npx allure generate allure-results --clean -o allure-report'
                }
            }

            echo 'Archivando reporte Allure y capturas de pantalla...'
            // 1. Archiva el reporte HTML completo y los resultados (funciona de forma nativa en Jenkins)
            archiveArtifacts artifacts: 'allure-report/**, allure-results/**', allowEmptyArchive: true

            // 2. Si tienes el plugin HTML Publisher instalado en Jenkins, puedes descomentar:
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'allure-report',
                reportFiles: 'index.html',
                reportName: 'Reporte Allure'
            ])

            echo 'Limpiando workspace...'
            cleanWs()
        }
        success {
            echo '¡Todas las pruebas de WebdriverIO pasaron exitosamente!'
        }
        failure {
            echo 'Falló alguna prueba o etapa del pipeline.'
        }
    }
}
