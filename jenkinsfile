pipeline {
    agent any

    tools {
        maven 'Maven' // Nombre del Maven configurado en Jenkins
        jdk 'Java'   // Nombre del JDK configurado en Jenkins
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Clonando el repositorio...'
                git branch: 'karaterama', url: 'https://github.com/Soysakiaytuno/jenkins-prueba-qa2.git'
            }
        }

        stage('Build & Test') {
            steps {
                echo 'Ejecutando pruebas Karate...'
                // El pom.xml se encuentra dentro de 'myproject', por lo que debemos ingresar a ese directorio
                dir('myproject') {
                    script {
                        if (isUnix()) {
                            sh 'mvn clean test'
                        } else {
                            bat 'mvn clean test'
                        }
                    }
                }
            }
        }

        stage('Publicar Reporte') {
            steps {
                echo 'Publicando reporte HTML de Karate...'
                // Se publica en el bloque post/always para que el reporte esté disponible
                // incluso si alguna prueba falló (lo cual causaría que un stage normal se salte)
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'myproject/target/karate-reports',
                    reportFiles: 'karate-summary.html',
                    reportName: 'Reporte de Pruebas Karate'
                ])

                // Publicación opcional de métricas JUnit para gráficos nativos en Jenkins
                junit allowEmptyResults: true, testResults: 'myproject/target/surefire-reports/*.xml, myproject/target/karate-reports/*.xml'

                echo 'Limpiando workspace...'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizado — limpiando workspace.'
            cleanWs()
        }
        success {
            echo 'Pruebas Karate ejecutadas con éxito.'
        }
        failure {
            echo 'Falló alguna etapa del pipeline.'
        }
    }
}
