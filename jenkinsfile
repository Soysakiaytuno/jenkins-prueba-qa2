pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'Java'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Clonando el repositorio...'
                git branch: 'karaterama', url: 'https://github.com/Soysakiaytuno/jenkins-prueba-qa2.git'
            }
        }

        stage('Build & Test') {
            steps {
                echo 'Ejecutando pruebas Karate...'
                dir('myproject') {
                    script {
                        // -Dtest=ExamplesTest ejecuta solo el runner paralelo (evita duplicar pruebas)
                        // Si quieres ejecutar runners individuales, puedes dejar solo 'mvn clean test'
                        def mvnCmd = isUnix() ? 'mvn clean test -Dtest=ExamplesTest' : 'bat "mvn clean test -Dtest=ExamplesTest"'
                        if (isUnix()) {
                            sh 'mvn clean test -Dtest=ExamplesTest'
                        } else {
                            bat 'mvn clean test -Dtest=ExamplesTest'
                        }
                    }
                }
            }
        }
    }

        post {
        always {
            echo 'Publicando reporte HTML de Karate...'

            // Publica el reporte HTML con pestaña directa en Jenkins
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'myproject/target/karate-reports',
                reportFiles: 'karate-summary.html',
                reportName: 'Reporte de Pruebas Karate'
            ])

            // Gráficos de tendencias JUnit nativos
            junit allowEmptyResults: true, testResults: 'myproject/target/karate-reports/*.xml'

            echo 'Limpiando workspace...'
            cleanWs()
        }
        success {
            echo '¡Todas las pruebas de Karate pasaron exitosamente!'
        }
        failure {
            echo 'Falló alguna etapa o prueba del pipeline.'
        }
    }
}
